{
  "name": "yunjian-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "云涧 · 东方美学全栈站点（Nuxt 4 + Prisma + PostgreSQL + Vant + Tailwind + 七牛云）",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/fix-edgeone-prisma.js",
    "preview": "nuxt preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "deploy:edgeone": "edgeone makers deploy -n yunjian-site",
    "deploy:edgeone:preview": "edgeone makers deploy -n yunjian-site -e preview"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "marked": "^18.1.3",
    "nuxt": "^4.6.4",
    "qiniu": "^7.15.2",
    "qrcode": "^1.5.4",
    "vant": "^4.10.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
