# ==================== 数据库（Prisma / PostgreSQL）====================
DATABASE_URL="postgresql://<用户名>:<密码>@<主机>:5432/<数据库>?schema=public"

# ==================== 鉴权 ====================
# 生产环境务必替换为随机强密钥，例如：openssl rand -base64 32
AUTH_SECRET="please-replace-with-a-long-random-secret"

# ==================== 演示模式 ====================
# true：数据库不可用时自动回退内置演示数据，并允许 demo 账号登录后台（便于先看效果）
# 生产环境必须设为 false
DEMO_MODE="true"

# ==================== 七牛云对象存储 ====================
# 留空时上传接口会返回明确提示，媒体管理可先使用「外链图片」方式
# 域名不含 https:// 与结尾斜杠；两个域名通常填同一个值
NUXT_QINIU_ACCESS_KEY=""
NUXT_QINIU_SECRET_KEY=""
NUXT_QINIU_BUCKET=""
NUXT_QINIU_REGION="z0"
# 服务端：拼接上传成功后的图片 URL
NUXT_QINIU_CDN_DOMAIN=""
# 客户端：把七牛 key 解析为完整图片地址（需已备案的 CDN 域名）
NUXT_PUBLIC_QINIU_CDN_DOMAIN=""

# ==================== 图片压缩 / CDN 加速（均有默认值，可整段省略）====================
# 上传前在浏览器内压缩：等比缩放长边 + WebP 编码，减少上传流量与对象存储占用
NUXT_PUBLIC_IMAGE_COMPRESS="true"          # 设为 false 可全局关闭压缩
NUXT_PUBLIC_IMAGE_MAX_EDGE="1920"          # 上传图长边上限（px）
NUXT_PUBLIC_IMAGE_QUALITY="82"             # 上传压缩质量 1-100
NUXT_PUBLIC_IMAGE_MIN_SIZE="24576"         # 小于该字节数且尺寸合规的图片跳过压缩
# 前台渲染时由七牛 imageView2 实时输出「按屏宽缩略的 WebP」，原图永久保留
NUXT_PUBLIC_IMAGE_CDN_QUALITY="82"         # CDN 输出质量 1-100
# 响应式候选宽度（逗号分隔，浏览器按 DPR × sizes 自动选档）
NUXT_PUBLIC_IMAGE_SRCSET_WIDTHS="320,480,640,800,1200,1600"

# ==================== 站点 ====================
NUXT_PUBLIC_SITE_NAME="云涧"
# 站点正式域名，供分享链接 / 二维码 / OG 卡片使用；留空则自动取当前请求域名
# 例：NUXT_PUBLIC_SITE_URL="https://www.example.com"
NUXT_PUBLIC_SITE_URL=""

# ==================== 微信内分享（可选扩展）====================
# 说明：微信内置浏览器不允许普通网页直接调起「发送给朋友 / 分享到朋友圈」，
# 须使用公众号 JS-SDK（认证服务号 + 已备案的 JS 接口安全域名 + 服务端 jsapi_ticket 签名）。
# 当前实现已覆盖：微信内引导右上角菜单、非微信环境二维码扫码、分享海报、系统原生分享。
# 若后续需要微信内自动注入分享卡片，可在此补 appId / AppSecret 并新增签名接口。

# ==================== 腾讯云 EdgeOne Pages 部署 ====================
# 本文件只用于本地开发。部署时这些变量必须在 EdgeOne 控制台
# 「项目设置 → 环境变量」配置，或用 `edgeone makers env add KEY VALUE` 写入；
# .env 已被 .gitignore 忽略，不会随构建产物上传。
# 必填：DATABASE_URL、AUTH_SECRET、DEMO_MODE=false、
#       NUXT_QINIU_ACCESS_KEY / NUXT_QINIU_SECRET_KEY / NUXT_QINIU_BUCKET /
#       NUXT_QINIU_CDN_DOMAIN / NUXT_PUBLIC_QINIU_CDN_DOMAIN
# 部署成功后把 NUXT_PUBLIC_SITE_URL 改成正式域名（分享链接、OG 卡片、二维码依赖它）。
# 数据库需允许 EdgeOne 云函数所在地域（默认广州 / 新加坡）访问 5432 端口。
# 构建 Node 版本见 .nvmrc（24.5.0）；云函数运行时为 RHEL + OpenSSL 1.1.x 镜像，
# prisma/schema.prisma 的 binaryTargets 已包含 rhel-openssl-1.1.x，请勿删除，
# 否则线上会报 "could not locate the Query Engine"。
# 线上出问题时先访问 /api/health/db 查看脱敏后的自诊断报告。
# 部署：先 `edgeone login`（或设置 EDGEONE_PAGES_API_TOKEN），再 `npm run deploy:edgeone`
